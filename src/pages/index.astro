---

<Layout title="SourceOnFire" description="Software And Gamedev Page">
    <div class="flex flex-col gap-10">

        <!--
        <SectionContainer id="all_tags" title="Buscar por Tags">
            <div class="mx-auto px-2 pt-2 pb-2 text-center mt-10 mb-2">
                {allTags?.map((pill: any) => <Pill pillname={pill} />)}
            </div>
        </SectionContainer> 
        -->
    
        <SectionContainer id="all" title="Lo Nuevo">
            <section>
                <div class="grid grid-cols-1 gap-5">
                     <ul class="grid grid-cols-1 lg:grid-cols-3 gap-3">
                        {
                            posts
                            .map((post: any) => (
                                <li>
                                    <PostCard
                                        link={`/${post.slug}/`}
                                        title={post.data.title}
                                        imgSrc={post.data.heroImage}
                                        description={post.data.description}
                                        isFirst={false}
                                    />
                                </li>
                            ))
                        }
                    </ul>
                </div>  
            </section>
        </SectionContainer>
</Layout>
