---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import AllPost from "../components/post/AllPost.astro";
import Pill from "../components/buttons/Pill.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []))];
allTags.sort();
---

<Layout title="SourceOnFire" description="Software And Gamedev Page">
    <div class="flex flex-col gap-10">

        <div class="mx-auto px-2 pt-2 pb-2 text-center mt-5 mb-2">
            {allTags?.map((pill: any) => <Pill pillname={pill} />)}
        </div>
    
        <SectionContainer id="all" title="Lo Nuevo">
            <section>
                <AllPost limit={20} postType="all"/>
            </section>
        </SectionContainer>
    </div>
</Layout>
