---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import PostGrid from "../../components/post/PostGrid.astro";
import AllPost from "../../components/post/AllPost.astro";

export const getStaticPaths = (async ({ paginate }) => {
    const pages = await getCollection("posts");
    return paginate(pages, { pageSize: 10 });
}) satisfies GetStaticPaths;

---

<Layout title="All" description="all">
    <SectionContainer id="all" title={"All"}>
        <AllPost limit={20} postType="all"/> 
    </SectionContainer>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const tag = params.get('tag');

  console.log("El tag es:", tag);
</script>
