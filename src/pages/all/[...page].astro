---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import PostGrid from "../../components/post/PostGrid.astro";
import AllPost from "../../components/post/AllPost.astro";


//const paramName = Astro.url.searchParams.get('tagName');

//const pg = Astro.params.page;
//const segments = pg ? pg.split('/') : [];
//const lastSegment = pg[pg.length - 1];
//const paramName = lastSegment?.substring(2);


export const getStaticPaths = (async ({ paginate }) => {
    const pages = await getCollection("posts");
    return paginate(pages, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title="All" description="all">
    <SectionContainer id="all" title={page[0]}>
        <AllPost limit={20} postType="all"/>
    </SectionContainer>
</Layout>
