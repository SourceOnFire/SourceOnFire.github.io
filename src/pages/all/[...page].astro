---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import PostGrid from "../../components/post/PostGrid.astro";

const { slug } = Astro.params;
const segments = slug ? slug.split('/') : [];
const paramName = segments[segments.length - 1];

export const getStaticPaths = (async ({ paginate }) => {
    const pages = await getCollection("posts");
    return paginate(pages, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<h1>Probando Slug: {slug}</h1>
<h1>Probando Segmento Final: {paramName}</h1>

<Layout title="All" description="all">
    <SectionContainer id="all" title="All">
        <AllPost limit={20} postType="all"/>
    </SectionContainer>
</Layout>
