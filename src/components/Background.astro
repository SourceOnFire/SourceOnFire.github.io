---
//bg-neutral-100 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(96,165,250,0.5),rgba(255,255,255,0))]
//dark:bg-neutral-950 dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(59,130,246,0.5),rgba(255,255,255,0))]"
---


<div
    class="fixed top-0 bottom-0 z-[-2] h-screen w-screen
        bg-slate-100
		dark:bg-neutral-950 dark:bg-[radial-gradient(ellipse_90%_90%_at_50%_110%,rgba(59,130,246,0.5),rgba(59,130,246,0.1))]"
>
	
</div>

<div class="stars-container">
	<div class="stars"></div>
  	<div class="stars2"></div>
  	<div class="stars3"></div>
</div>

<style>


 
  .stars-container {
    position: fixed;
    top: 0;
    
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1; /* Se coloca detrás de todo el contenido */
    /*background: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%);*/
  }


  .stars {
    width: 1px;
    height: 1px;
    background: transparent;
    box-shadow: 
      12vw 15vh #fff, 85vw 45vh #fff, 42vw 88vh #fff, 
      75vw 12vh #fff, 15vw 70vh #fff, 90vw 80vh #fff,
      30vw 30vh #fff, 60vw 95vh #fff, 5vw 45vh #fff,
      95vw 25vh #fff, 50vw 10vh #fff, 25vw 90vh #fff,
      70vw 50vh #fff, 40vw 60vh #fff, 10vw 10vh #fff,
      88vw 92vh #fff, 35vw 20vh #fff, 65vw 35vh #fff;
    animation: twinkle 3s ease-in-out infinite alternate;
  }

 
  .stars2 {
    width: 2px;
    height: 2px;
    background: transparent;
    box-shadow: 
      20vw 80vh #fff, 55vw 15vh #fff, 80vw 60vh #fff,
      10vw 25vh #fff, 45vw 40vh #fff, 70vw 85vh #fff,
      25vw 50vh #fff, 90vw 10vh #fff, 35vw 75vh #fff,
      65vw 20vh #fff, 5vw 90vh #fff, 85vw 90vh #fff;
    animation: twinkle 5s ease-in-out infinite alternate;
  }

 
  .stars3 {
    width: 3px;
    height: 3px;
    background: transparent;
    box-shadow: 
     	50vw 50vh #fff, 15vw 40vh #fff, 85vw 20vh #fff,
      	30vw 80vh #fff, 75vw 75vh #fff, 40vw 10vh #fff,
      	95vw 65vh #fff, 10vw 60vh #fff, 60vw 40vh #fff;
    animation: twinkle 4s ease-in-out infinite;
  }

  
  /* @keyframes animStar {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(-2000px);
    }
  }*/

  /* Animación de titileo (opacidad) */
  @keyframes twinkle {
    0%, 100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
</style>
