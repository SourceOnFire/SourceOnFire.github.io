---
//bg-neutral-100 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(96,165,250,0.5),rgba(255,255,255,0))]
//dark:bg-neutral-950 dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(59,130,246,0.5),rgba(255,255,255,0))]"
---


<div
    class="fixed top-0 bottom-0 z-[-2] h-screen w-screen
        bg-slate-100
		dark:bg-neutral-950 dark:bg-[radial-gradient(ellipse_100%_100%_at_50%_110%,rgba(59,130,246,0.5),rgba(59,130,246,0.1))]"
>
	<div class="stars"></div>
  	<div class="stars2"></div>
  	<div class="stars3"></div>
</div>

<style>
 
  .stars-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1; /* Se coloca detrás de todo el contenido */
    background: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%);
  }


  .stars {
    width: 1px;
    height: 1px;
    background: transparent;
    box-shadow: 
      1040px 200px #FFF, 500px 800px #FFF, 1200px 300px #FFF, 
      200px 100px #FFF, 800px 600px #FFF, 1500px 900px #FFF,
      300px 400px #FFF, 900px 100px #FFF, 600px 700px #FFF,
      1300px 500px #FFF, 100px 900px #FFF, 1100px 200px #FFF;
    animation: animStar 50s linear infinite;
  }

 
  .stars2 {
    width: 2px;
    height: 2px;
    background: transparent;
    box-shadow: 
      300px 500px #FFF, 900px 200px #FFF, 1400px 700px #FFF,
      100px 300px #FFF, 700px 900px #FFF, 400px 100px #FFF,
      1100px 600px #FFF, 500px 400px #FFF, 800px 300px #FFF;
    animation: animStar 100s linear infinite;
  }

 
  .stars3 {
    width: 3px;
    height: 3px;
    background: transparent;
    box-shadow: 
      500px 200px #FFF, 200px 700px #FFF, 1000px 400px #FFF,
      700px 100px #FFF, 1300px 800px #FFF, 300px 900px #FFF;
    animation: twinkle 4s ease-in-out infinite;
  }

  
  @keyframes animStar {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(-2000px);
    }
  }

  /* Animación de titileo (opacidad) */
  @keyframes twinkle {
    0%, 100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
</style>
